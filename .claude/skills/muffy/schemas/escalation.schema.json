{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "muffy/escalation.schema.json",
  "title": "Muffy escalation report",
  "description": "Written by the Orchestrator to .team/<task>/escalation-<n>.json when a loop is cut off. Presented to the user via AskUserQuestion.",
  "type": "object",
  "additionalProperties": false,
  "required": ["task", "step", "trigger", "loops_used", "loop_limit", "owner", "open_blockers", "attempts", "options"],
  "properties": {
    "task": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "step": { "type": "string", "pattern": "^([1-9]|1[0-2])[a-d]?$" },
    "trigger": { "enum": ["loop-limit", "repeated-blocker", "invalid-handoff", "quality-check-failed-twice", "agent-unavailable", "human-reject-limit"] },
    "loops_used": { "type": "integer", "minimum": 1 },
    "loop_limit": { "type": "integer", "minimum": 1 },
    "owner": { "type": "string", "minLength": 2 },
    "open_blockers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "problem", "rounds_open"],
        "properties": {
          "id": { "type": "string", "pattern": "^B-[0-9]+$" },
          "problem": { "type": "string", "minLength": 3 },
          "file": { "type": "string" },
          "rounds_open": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "attempts": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 3 }, "description": "One line per round: what was tried" },
    "recommendation": { "type": "string" },
    "options": {
      "type": "array",
      "minItems": 2,
      "maxItems": 4,
      "items": { "enum": ["extend-loops", "change-approach", "reduce-scope", "fix-manually", "abort-task"] }
    }
  }
}
