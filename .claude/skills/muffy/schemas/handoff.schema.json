{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "muffy/handoff.schema.json",
  "title": "Muffy agent hand-off",
  "description": "Machine-readable tail of every subagent final message. The Orchestrator saves it as .team/<task>/handoff/<step>-<role>-r<round>.json and validates it before moving on.",
  "type": "object",
  "additionalProperties": false,
  "required": ["role", "task", "step", "round", "status", "paths_written", "blockers", "quality_checks", "summary"],
  "properties": {
    "role": { "enum": ["researcher", "product-manager", "designer", "architect", "devops", "frontend-dev", "backend-dev", "code-reviewer", "qa-tester", "docs-writer"] },
    "task": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "step": { "type": "string", "pattern": "^([1-9]|1[0-2])[a-d]?$" },
    "mode": { "enum": [1, 2, 3], "description": "devops only" },
    "round": { "type": "integer", "minimum": 1, "description": "1 = first attempt; +1 per fix round" },
    "status": { "enum": ["done", "blocked", "needs-input", "not-ready"] },
    "verdict": { "enum": ["Approve", "Reject", "Pass", "Fail"] },
    "paths_written": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "ac_ids_done": { "type": "array", "items": { "type": "string", "pattern": "^AC-[0-9]+$" } },
    "tests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passed", "total"],
      "properties": { "passed": { "type": "integer", "minimum": 0 }, "total": { "type": "integer", "minimum": 0 } }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "problem", "owner"],
        "properties": {
          "id": { "type": "string", "pattern": "^B-[0-9]+$", "description": "Stable across rounds so a repeated blocker is detectable" },
          "problem": { "type": "string", "minLength": 3, "maxLength": 300 },
          "file": { "type": "string", "pattern": "^[^\\s:]+(:[0-9]+)?$" },
          "ac_ids": { "type": "array", "items": { "type": "string", "pattern": "^AC-[0-9]+$" } },
          "owner": { "enum": ["FE", "BE", "Docs", "Devops", "Architect", "Designer", "PM", "Researcher"] }
        }
      }
    },
    "quality_checks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passed", "failed"],
      "properties": {
        "passed": { "type": "boolean", "description": "true only if every item in the agent's quality-checks.md holds" },
        "failed": { "type": "array", "items": { "type": "string", "minLength": 3 } }
      }
    },
    "brain_note": { "type": "string", "description": "Path of the <brain>/agents/<role>/<task>.md written; absent for code-reviewer (Orchestrator writes it)" },
    "summary": { "type": "string", "minLength": 3, "maxLength": 600 }
  },
  "allOf": [
    { "if": { "properties": { "role": { "enum": ["code-reviewer"] } }, "required": ["role"] }, "then": { "required": ["verdict"], "properties": { "verdict": { "enum": ["Approve", "Reject"] } } } },
    { "if": { "properties": { "role": { "enum": ["qa-tester"] } }, "required": ["role"] }, "then": { "required": ["verdict", "tests"], "properties": { "verdict": { "enum": ["Pass", "Fail"] } } } },
    { "if": { "properties": { "role": { "enum": ["devops"] } }, "required": ["role"] }, "then": { "required": ["mode"] } },
    { "if": { "properties": { "role": { "enum": ["frontend-dev", "backend-dev"] } }, "required": ["role"] }, "then": { "required": ["ac_ids_done"] } },
    { "if": { "properties": { "verdict": { "enum": ["Reject", "Fail"] } }, "required": ["verdict"] }, "then": { "properties": { "blockers": { "minItems": 1 } } } },
    { "if": { "properties": { "quality_checks": { "properties": { "passed": { "enum": [false] } }, "required": ["passed"] } }, "required": ["quality_checks"] }, "then": { "properties": { "status": { "enum": ["not-ready", "blocked", "needs-input"] }, "quality_checks": { "properties": { "failed": { "minItems": 1 } } } } } }
  ]
}
