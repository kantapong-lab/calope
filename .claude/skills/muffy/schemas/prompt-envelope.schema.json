{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "muffy/prompt-envelope.schema.json",
  "title": "Muffy subagent prompt envelope",
  "description": "Parsed form of the prompt template in references/token-discipline.md. Used by evals and mock scenarios to check Orchestrator prompts are lean and complete.",
  "type": "object",
  "additionalProperties": false,
  "required": ["goal", "task", "brain", "read", "write", "dont_touch"],
  "properties": {
    "goal": { "type": "string", "minLength": 3, "maxLength": 200 },
    "task": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "brain": { "type": "string", "minLength": 1 },
    "vault": { "type": "string" },
    "mode": { "enum": [1, 2, 3] },
    "read": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "write": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "dont_touch": { "type": "array", "items": { "type": "string" } },
    "checkpoint": { "type": "string", "description": "Path of .team/<task>/checkpoint.md; required from round 2 or after a context summary" }
  }
}
