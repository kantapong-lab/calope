# Names only. Never commit real values. Set real values in Vercel Project Settings > Environment Variables
# (scope Preview/staging and Production separately) and in a git-ignored .env.local for local dev.
# Server-side only: never prefix with NEXT_PUBLIC_ (that would ship the value to the client bundle, breaks AC-19).

# Anthropic API key (server-side only, used by the backend route handler)
ANTHROPIC_API_KEY=

# Exact model ID, no alias (AC-21). Default: claude-sonnet-5-5. Spike candidate: claude-haiku-5-5
FOOD_VISION_MODEL=
