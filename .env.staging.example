# Names only. Copy to .env.staging.local (git-ignored) and fill in for docker compose staging.
# DATABASE_URL host is the compose service name "db". Host-side tests use localhost:5432 instead.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
DATABASE_URL=postgres://USER:PASSWORD@db:5432/DB
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Required at startup by the config check. Use a real key only when live calls are approved.
ANTHROPIC_API_KEY=
# Public URL of the app, used by the Origin check on non-GET calls (e.g. http://localhost:3000). If empty, the Host header is used.
APP_ORIGIN=
