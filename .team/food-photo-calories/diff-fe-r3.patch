+-+/* Calope design tokens. Only place raw values live. Created in task food-photo-calories. */
+-+:root {
+-+  /* Primitive: neutral ramp (hue 215, chroma tiny) */
+-+  --neutral-0: oklch(1 0 0);
+-+  --neutral-50: oklch(0.98 0.004 215);
+-+  --neutral-100: oklch(0.955 0.006 215);
+-+  --neutral-200: oklch(0.91 0.008 215);
+-+  --neutral-300: oklch(0.84 0.01 215);
+-+  --neutral-500: oklch(0.58 0.014 215);
+-+  --neutral-600: oklch(0.48 0.016 215);
+-+  --neutral-800: oklch(0.28 0.02 215);
+-+  --neutral-900: oklch(0.2 0.022 215);
+-+
+-+  /* Primitive: brand ramp (deep teal) */
+-+  --brand-50: oklch(0.96 0.02 205);
+-+  --brand-100: oklch(0.91 0.04 205);
+-+  --brand-300: oklch(0.75 0.09 205);
+-+  --brand-600: oklch(0.46 0.09 215);
+-+  --brand-700: oklch(0.39 0.08 215);
+-+
+-+  /* Primitive: status ramps */
+-+  --success-100: oklch(0.94 0.05 150);
+-+  --success-700: oklch(0.42 0.1 150);
+-+  --warning-100: oklch(0.95 0.07 85);
+-+  --warning-800: oklch(0.4 0.09 70);
+-+  --danger-100: oklch(0.94 0.04 25);
+-+  --danger-700: oklch(0.45 0.16 25);
+-+  --info-100: oklch(0.94 0.03 250);
+-+  --info-700: oklch(0.43 0.12 250);
+-+
+-+  /* Semantic color */
+-+  --color-bg: var(--neutral-50);
+-+  --color-surface: var(--neutral-0);
+-+  --color-surface-sunken: var(--neutral-100);
+-+  --color-text: var(--neutral-900);
+-+  --color-text-muted: var(--neutral-600);
+-+  --color-border: var(--neutral-300);
+-+  --color-primary: var(--brand-600);
+-+  --color-primary-hover: var(--brand-700);
+-+  --color-on-primary: var(--neutral-0);
+-+  --color-primary-subtle: var(--brand-50);
+-+  --color-focus: var(--brand-600);
+-+  --color-success-bg: var(--success-100);
+-+  --color-success-text: var(--success-700);
+-+  --color-warning-bg: var(--warning-100);
+-+  --color-warning-text: var(--warning-800);
+-+  --color-danger-bg: var(--danger-100);
+-+  --color-danger-text: var(--danger-700);
+-+  --color-info-bg: var(--info-100);
+-+  --color-info-text: var(--info-700);
+-+  --color-scrim: oklch(0.2 0.022 215 / 0.5);
+-+
+-+  /* Typography: one family, Thai + Latin */
+-+  --font-sans: "IBM Plex Sans Thai", "Noto Sans Thai", system-ui, sans-serif;
+-+  --text-xs: 0.8125rem;   /* 13 */
+-+  --text-sm: 0.9375rem;   /* 15 */
+-+  --text-md: 1rem;        /* 16 */
+-+  --text-lg: 1.375rem;    /* 22 */
+-+  --text-xl: 1.625rem;    /* 26 */
+-+  --text-2xl: 2rem;       /* 32 */
+-+  --weight-regular: 400;
+-+  --weight-medium: 500;
+-+  --weight-semibold: 600;
+-+  /* Thai needs taller lines for stacked vowels/tone marks */
+-+  --leading-body: 1.6;
+-+  --leading-tight: 1.35;
+-+  --measure: 65ch;
+-+
+-+  /* Spacing: 4px base */
+-+  --space-1: 0.25rem;
+-+  --space-2: 0.5rem;
+-+  --space-3: 0.75rem;
+-+  --space-4: 1rem;
+-+  --space-5: 1.25rem;
+-+  --space-6: 1.5rem;
+-+  --space-8: 2rem;
+-+  --space-10: 2.5rem;
+-+  --space-12: 3rem;
+-+  --target-min: 2.75rem;  /* 44px touch target */
+-+  --layout-max: 40rem;    /* single column, phone-first */
+-+
+-+  /* Radius */
+-+  --radius-sm: 0.5rem;    /* inputs, chips */
+-+  --radius-md: 0.75rem;   /* panels, dialogs */
+-+  --radius-full: 999px;   /* pills, badges */
+-+
+-+  /* Elevation: borders first, one shadow for overlays */
+-+  --shadow-overlay: 0 8px 24px oklch(0.2 0.022 215 / 0.18);
+-+
+-+  /* Motion */
+-+  --duration-fast: 120ms;
+-+  --duration-base: 220ms;
+-+  --ease-out: cubic-bezier(0.25, 1, 0.5, 1);
+-+
+-+  /* Z-index scale */
+-+  --z-sticky: 10;
+-+  --z-dialog: 30;
+-+  --z-toast: 40;
+-+}
+-+
+-+@media (prefers-color-scheme: dark) {
+-+  :root {
+-+    --color-bg: var(--neutral-900);
+-+    --color-surface: oklch(0.24 0.022 215);
+-+    --color-surface-sunken: oklch(0.17 0.02 215);
+-+    --color-text: oklch(0.96 0.005 215);
+-+    --color-text-muted: oklch(0.78 0.012 215);
+-+    --color-border: oklch(0.42 0.02 215);
+-+    --color-primary: oklch(0.78 0.09 205);
+-+    --color-primary-hover: oklch(0.84 0.08 205);
+-+    --color-on-primary: oklch(0.2 0.022 215);
+-+    --color-primary-subtle: oklch(0.3 0.04 215);
+-+    --color-focus: oklch(0.82 0.09 205);
+-+    --color-success-bg: oklch(0.3 0.05 150);
+-+    --color-success-text: oklch(0.88 0.09 150);
+-+    --color-warning-bg: oklch(0.32 0.05 80);
+-+    --color-warning-text: oklch(0.9 0.09 85);
+-+    --color-danger-bg: oklch(0.3 0.06 25);
+-+    --color-danger-text: oklch(0.88 0.08 25);
+-+    --color-info-bg: oklch(0.3 0.05 250);
+-+    --color-info-text: oklch(0.88 0.06 250);
+-+    --color-scrim: oklch(0 0 0 / 0.6);
+-+  }
+-+}
+-+
+-+@media (prefers-reduced-motion: reduce) {
+-+  :root { --duration-fast: 0ms; --duration-base: 0ms; }
+-+}
