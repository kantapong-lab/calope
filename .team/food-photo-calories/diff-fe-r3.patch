+    expect(confidenceLevel(0.6)).toBe("medium");
+    expect(confidenceLevel(0.49)).toBe("low");
+  });
+
+  it("sums totals", () => {
+    expect(totals([{ kcal_low: 520, kcal_high: 680 }, { kcal_low: 60, kcal_high: 110 }])).toEqual({ low: 580, high: 790 });
