@@ -0,0 +1,128 @@
+/* Calope design tokens. Only place raw values live. Created in task food-photo-calories. */
+:root {
+  /* Primitive: neutral ramp (hue 215, chroma tiny) */
+  --neutral-0: oklch(1 0 0);
+  --neutral-50: oklch(0.98 0.004 215);
+  --neutral-100: oklch(0.955 0.006 215);
+  --neutral-200: oklch(0.91 0.008 215);
+  --neutral-300: oklch(0.84 0.01 215);
+  --neutral-500: oklch(0.58 0.014 215);
+  --neutral-600: oklch(0.48 0.016 215);
+  --neutral-800: oklch(0.28 0.02 215);
+  --neutral-900: oklch(0.2 0.022 215);
+
+  /* Primitive: brand ramp (deep teal) */
+  --brand-50: oklch(0.96 0.02 205);
+  --brand-100: oklch(0.91 0.04 205);
+  --brand-300: oklch(0.75 0.09 205);
+  --brand-600: oklch(0.46 0.09 215);
+  --brand-700: oklch(0.39 0.08 215);
+
+  /* Primitive: status ramps */
+  --success-100: oklch(0.94 0.05 150);
+  --success-700: oklch(0.42 0.1 150);
+  --warning-100: oklch(0.95 0.07 85);
+  --warning-800: oklch(0.4 0.09 70);
+  --danger-100: oklch(0.94 0.04 25);
+  --danger-700: oklch(0.45 0.16 25);
+  --info-100: oklch(0.94 0.03 250);
+  --info-700: oklch(0.43 0.12 250);
+
+  /* Semantic color */
+  --color-bg: var(--neutral-50);
+  --color-surface: var(--neutral-0);
+  --color-surface-sunken: var(--neutral-100);
+  --color-text: var(--neutral-900);
+  --color-text-muted: var(--neutral-600);
+  --color-border: var(--neutral-300);
+  --color-primary: var(--brand-600);
+  --color-primary-hover: var(--brand-700);
+  --color-on-primary: var(--neutral-0);
+  --color-primary-subtle: var(--brand-50);
+  --color-focus: var(--brand-600);
+  --color-success-bg: var(--success-100);
+  --color-success-text: var(--success-700);
+  --color-warning-bg: var(--warning-100);
+  --color-warning-text: var(--warning-800);
+  --color-danger-bg: var(--danger-100);
+  --color-danger-text: var(--danger-700);
+  --color-info-bg: var(--info-100);
+  --color-info-text: var(--info-700);
+  --color-scrim: oklch(0.2 0.022 215 / 0.5);
+
+  /* Typography: one family, Thai + Latin */
+  --font-sans: "IBM Plex Sans Thai", "Noto Sans Thai", system-ui, sans-serif;
+  --text-xs: 0.8125rem;   /* 13 */
+  --text-sm: 0.9375rem;   /* 15 */
+  --text-md: 1rem;        /* 16 */
+  --text-lg: 1.375rem;    /* 22 */
